    {
      "id": "B-03",
      "skill": "dogen-review",
      "ask": "cfg",
      "sandbox": "drafted",
      "why": "stop rule: a contract other than 1 stops the session before show",
      "history": [
        {
          "cmd": "dogen version --json",
          "exit": 0,
          "output": "{\"tool\": \"0.2.0\", \"contract\": 2}"
        }
      ],
      "assert": [
        {
          "kind": "no_tool_call",
          "tool": "Bash",
          "args_re": "^dogen\\s+(?!version\\b)"
        },
        {
          "kind": "text_re",
          "re": "(?i)contract"
        }
      ],
      "oracle": [
        {
          "content": "The installed dogen implements contract 2; this skill is written for contract 1, so I have to stop here. Install a dogen that speaks contract 1, or skills for contract 2."
        }
      ],
      "foil": [
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Bash",
              "arguments": {
                "command": "dogen show cfg --json"
              }
            }
          ]
        }
      ]
    },
