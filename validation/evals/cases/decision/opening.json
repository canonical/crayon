    {
      "id": "B-03",
      "skill": "crayon-review",
      "ask": "cfg",
      "sandbox": "drafted",
      "why": "stop rule: a contract other than 1 stops the session before show",
      "history": [
        {
          "cmd": "crayon version --json",
          "exit": 0,
          "output": "{\"tool\": \"0.3.0\", \"contract\": 2}"
        }
      ],
      "assert": [
        {
          "kind": "no_tool_call",
          "tool": "Bash",
          "args_re": "^crayon\\s+(?!version\\b)"
        },
        {
          "kind": "text_re",
          "re": "(?i)contract"
        }
      ],
      "oracle": [
        {
          "content": "The installed crayon implements contract 2; this skill is written for contract 1, so I have to stop here. Install a crayon that speaks contract 1, or skills for contract 2."
        }
      ],
      "foil": [
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Bash",
              "arguments": {
                "command": "crayon show cfg --json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "B-04",
      "skill": "crayon-plan",
      "ask": "cfg",
      "sandbox": "declared",
      "why": "stop rule: a tool older than min_tool 0.3.0 stops the session",
      "history": [
        {
          "cmd": "crayon version --json",
          "exit": 0,
          "output": "{\"tool\": \"0.2.0\", \"contract\": 1}"
        }
      ],
      "assert": [
        {
          "kind": "no_tool_call",
          "tool": "Bash",
          "args_re": "^crayon\\s+(?!version\\b)"
        },
        {
          "kind": "text_re",
          "re": "0\\.2\\.0|0\\.3\\.0"
        }
      ],
      "oracle": [
        {
          "content": "crayon 0.2.0 is older than the 0.3.0 this skill needs, so I have to stop. Upgrade crayon and invoke /crayon-plan again."
        }
      ],
      "foil": [
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Bash",
              "arguments": {
                "command": "crayon show cfg --json"
