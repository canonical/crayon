  "cases": [
    {
      "id": "B-05",
      "skill": "dogen-plan",
      "ask": "cfg",
      "opening": "declared",
      "why": "sign_off: read the plan back and get a go-ahead; never sign unasked",
      "assert": [
        {
          "kind": "asks_user"
        },
        {
          "kind": "no_tool_call",
          "tool": "Bash",
          "args_re": "\\bdogen\\s+signoff\\b"
        }
      ],
      "oracle": [
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Read",
              "arguments": {
                "file_path": ".dogen/units/cfg/unit.md"
              }
            }
          ]
        },
        {
          "content": "The plan: a reference page for every toyq setting, for operators configuring toyq on a server, from src/toyq/config.py, at reference/config.md. Shall I record the signoff?"
        }
      ],
      "foil": [
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Bash",
              "arguments": {
                "command": "dogen signoff cfg"
              }
            }
          ]
        }
      ]
    },
    {
