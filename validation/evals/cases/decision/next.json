      "oracle": [
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Bash",
              "arguments": {
                "command": "dogen signoff cfg"
              }
            }
          ]
        }
      ],
      "foil": [
        {
          "content": "Before I sign, shall I read the plan back once more?"
        }
      ]
    },
