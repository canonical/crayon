    {
      "id": "B-08",
      "skill": "dogen-write",
      "ask": "install",
      "opening": "walk",
      "max_turns": 14,
      "why": "walk: run the first step captured in the workspace (or ask first); no digest, no early draft",
      "assert": [
        {
          "kind": "any_of",
          "of": [
            {
              "kind": "decisive",
              "tool": "Bash",
              "args_re": "pip install toyq[^\\n]*\\)?\\s*>\\s*\\S+[^\\n]*2>&1"
            },
            {
              "kind": "asks_user"
            }
          ]
        },
        {
          "kind": "no_tool_call",
          "tool": "Bash",
          "args_re": "\\b[0-9a-f]{64}\\b"
        },
        {
          "kind": "no_tool_call",
          "tool": "Bash",
          "args_re": "\\bdogen\\s+(step|draft)\\b"
        },
        {
          "kind": "no_tool_call",
          "tool": "Bash",
          "args_re": "^\\s*pip install"
        }
      ],
      "oracle": [
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Bash",
              "arguments": {
                "command": "WS=.dogen/staging/install/scratch && mkdir -p $WS/evidence"
              }
            }
          ]
        },
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Bash",
              "arguments": {
                "command": "( cd .dogen/staging/install/scratch && pip install toyq ) > .dogen/staging/install/scratch/evidence/install.out 2>&1; echo \"exit:$?\""
              }
            }
          ]
        }
      ],
      "foil": [
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Bash",
              "arguments": {
                "command": "pip install toyq"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "B-09",
      "skill": "dogen-review",
      "ask": "cfg",
      "opening": "drafted",
      "why": "review: ask the reviewer to choose record or review mode before anything else",
      "assert": [
        {
          "kind": "decisive",
          "tool": "AskUserQuestion",
          "args_re": "(?i)\\brecord\\b"
        },
        {
          "kind": "tool_call",
          "tool": "AskUserQuestion",
          "which": "any",
          "args_re": "(?i)\\breview\\b"
        },
        {
          "kind": "no_tool_call",
          "tool": "Bash",
          "args_re": "@MUTATING"
        }
      ],
      "oracle": [
        {
          "content": "",
          "tool_calls": [
            {
              "name": "Bash",
              "arguments": {
                "command": "dogen summary cfg"
              }
            }
          ]
        },
        {
          "content": "",
          "tool_calls": [
            {
              "name": "AskUserQuestion",
              "arguments": {
                "questions": [
                  {
                    "question": "How do you want to review cfg?",
                    "options": [
                      {
                        "label": "record"
                      },
                      {
                        "label": "review"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
