            "arguments": {
              "file_path": ".crayon/staging/cfg/report.json",
              "content": "{\"origins\": [\"src/toyq/config.py\"], \"gaps\": []}\n"
            }
          },
          "result": "File written: .crayon/staging/cfg/report.json"
        },
        {
          "cmd": "crayon draft cfg .crayon/staging/cfg/draft/ --model-origin unknown --report .crayon/staging/cfg/report.json",
          "exit": 6,
          "output": "{\"error\": \"internal_error\", \"unit\": \"cfg\", \"detail\": \"unexpected internal fault: KeyError: 'basis'\", \"hint\": \"this is a crayon defect, not a diagnosis of your record; run crayon show on the unit, then re-run the same command unchanged and report the detail above\", \"next\": \"show\"}"
