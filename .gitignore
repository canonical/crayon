# Env / secrets
.env
.env.*

# OS / editor
.DS_Store
*.swp

# crayon passenger handoff staging — MUST stay scoped to the staging path:
# a blanket .crayon/ ignore would hide the committed .crayon/units/<id>/unit.md.
.crayon/staging/
.worktrees/

# Python bytecode from the stdlib test runners (no package, no venv).
__pycache__/
*.pyc

# The model-eval kit's local outputs: partial, dry and errored runs, full turn
# logs, and the response cache. Clean summaries in validation/evals/results/
# are committed; these never are.
validation/evals/results/raw/
validation/evals/.cache/

# GSD/crayon runtime state — generated per session or derived from the
# tracked planning docs; never hand-authored, so keep it out of history.
.gsd/
.planning/state.json
.planning/agent-history.json
.planning/research/.cache/
